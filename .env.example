# HTTP
PORT=8787

# PostgreSQL (pool's own database, isolated from account-onboard's)
DATABASE_URL=postgresql://postgres:password@postgres:5432/account_pool?sslmode=disable

# Redis (session/concurrency/scheduling)
REDIS_URL=redis://:password@redis:6379/0

# Credential re-encryption key (pool's own, never shared with account-onboard)
CREDENTIAL_ENCRYPTION_KEY=

# account-onboard export API this pool pulls from
ONBOARD_EXPORT_BASE_URL=
ONBOARD_EXPORT_API_KEY=
ONBOARD_PULL_INTERVAL_SECONDS=30
ONBOARD_REPORT_INTERVAL_SECONDS=60

# Client-facing API auth for the OpenAI-compatible endpoint
CLIENT_API_KEY=

# Proxy pool provider credentials
PROXY_POOL_PROVIDER_URL=
PROXY_POOL_PROVIDER_KEY=
